# ============================================================
#  Variables d'environnement — modèle
# ============================================================
# Copiez ce fichier en `.env.local` (en local) ou saisissez ces
# variables dans Vercel → Project → Settings → Environment Variables.
# NE METTEZ JAMAIS de vraies clés dans ce fichier : il est public.

# Adresse publique du site (sitemap, liens absolus, réseaux sociaux)
NEXT_PUBLIC_SITE_URL=https://www.votre-domaine.fr

# --- Envoi des commandes et messages par email (https://resend.com) ---
# Sans ces 3 variables, les commandes ne peuvent pas être transmises
# automatiquement : le client se voit proposer WhatsApp / email / téléphone.
RESEND_API_KEY=
EMAIL_FROM="Commandes <commandes@votre-domaine.fr>"
ORDER_NOTIFICATION_EMAIL=

# --- Paiement par carte (https://stripe.com) — facultatif ---
# Le paiement en ligne n'apparaît que si STRIPE_SECRET_KEY est défini.
# Utilisez d'abord les clés de test (sk_test_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Panel admin (/admin) ---
# Mot de passe de l'administration (12 caractères minimum conseillés).
ADMIN_PASSWORD=

# --- Base de données des commandes et du formulaire ---
# Créées AUTOMATIQUEMENT quand vous connectez Upstash Redis au projet
# (Vercel → Storage → Upstash → Connect). Rien à saisir à la main.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
